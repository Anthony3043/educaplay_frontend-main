{
  "expo": {
    "name": "EducaPlay",
    "slug": "educaplay-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "educaplayfrontend",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/logo_icon.png",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/logo_icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.educaplayfrontend",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_icon.png",
        "backgroundColor": "#3a7d44"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo_icon.png",
          "color": "#3a7d44",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3a7d44"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82bd4f03-c8df-487b-80a1-928dee68f7db"
      }
    }
  }
}
